{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "ignorePresets": ["security:minimumReleaseAgeNpm"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "groupSlug": "npm"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    },
    {
      "matchPackageNames": ["node", "pnpm", "bun"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    },
    {
      "matchManagers": ["custom"],
      "matchDatasources": ["node-version", "npm"],
      "matchPackageNames": ["node", "pnpm", "bun"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    },
    {
      // renovate's config for this is stale or wrong
      // doesn't match with what mise outdated -l sees
      "matchManagers": ["mise"],
      "matchPackageNames": ["biomejs/biome", "biome"],
      "overrideDatasource": "github-releases",
      "extractVersion": "^@biomejs/biome@(?<version>.*)$"
    },
    {
      // this is disabled by the best-practices preset, apparently
      "matchManagers": ["devcontainer"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      // this updates versions in package.json's devEngines
      // temporary, while https://github.com/renovatebot/renovate/issues/38067 is still open
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/package.json/"],
      "matchStrings": [
        "$map(devEngines.runtime, function($v) { { \"depName\": $v.name, \"currentValue\": $v.version, \"datasource\": $v.name = \"node\" ? \"node-version\" : \"npm\", \"versioning\": $v.name = \"node\" ? \"node\" : \"npm\" } })",
        "$map(devEngines.packageManager, function($v) { { \"depName\": $v.name, \"currentValue\": $v.version, \"datasource\": \"npm\", \"versioning\": \"npm\" } })"
      ]
    }
  ],
  "minimumReleaseAge": "1 day",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true
}
