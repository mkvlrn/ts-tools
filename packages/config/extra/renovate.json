{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:weekly"],
  "ignorePresets": ["security:minimumReleaseAgeNpm"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker images",
      "groupSlug": "docker"
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "npm dependencies",
      "groupSlug": "npm"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    },
    {
      "matchPackageNames": ["node", "pnpm", "bun"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    },
    {
      "matchManagers": ["custom"],
      "matchDatasources": ["node-version", "npm"],
      "matchPackageNames": ["node", "pnpm", "bun"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    },

    {
      // this is disabled by the best-practices preset, apparently
      "matchManagers": ["devcontainer"],
      "pinDigests": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "rebaseWhen": "behind-base-branch",
  "updateNotScheduled": true,
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true
}
