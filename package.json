{
  "name": "ts-tools",
  "description": "Assorted typescript tools for whatever",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Mike Valeriano <mkvlrn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkvlrn/ts-tools"
  },
  "keywords": [
    "node",
    "bun",
    "typescript",
    "tools"
  ],
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": [
      {
        "name": "bun",
        "version": "1.3.14"
      }
    ],
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "scripts": {
    "lint": "bun lint-check --write",
    "lint-check": "biome check --diagnostic-level=warn --no-errors-on-unmatched",
    "typecheck": "tsc",
    "typecheck-staged": "tsc-files",
    "test-staged": "bun test --changed --bail --reporter=dots",
    "test-ci": "bun test --bail --reporter=dots",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
