{
  "name": "ts-tools",
  "description": "Assorted typescript tools for whatever",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Mike Valeriano <mkvlrn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkvlrn/ts-tools"
  },
  "keywords": [
    "node",
    "bun",
    "typescript",
    "tools"
  ],
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "ignore"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "ignore"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "jsr": "0.14.3",
    "lefthook": "2.2.1",
    "typescript": "7.0.2"
  }
}
